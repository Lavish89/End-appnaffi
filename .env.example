# ===========================================================================
# KI-Anbieter (einer reicht). Reihenfolge: Groq/OpenRouter > Gemini > Heuristik.
# EMPFEHLUNG für "gratis & praktisch ohne Tageslimit": Groq.
#   -> https://console.groq.com  (kostenloser API-Key, sehr hohes Tageslimit)
# Trage NUR den Key bei deinem Hoster (z. B. Render -> Environment) ein, nie im Chat.
# ===========================================================================
# GROQ_API_KEY: Kostenloser Groq-Key (OpenAI-kompatibel, hohes Limit). Wird bevorzugt.
GROQ_API_KEY=""
# OPENROUTER_API_KEY: Alternative zu Groq (openrouter.ai), ebenfalls kostenlose Modelle.
OPENROUTER_API_KEY=""
# AI_PROVIDER: Erzwingt einen Anbieter: "groq" | "openrouter" | "gemini". Leer = automatisch.
AI_PROVIDER=""
# AI_MODEL: Optionales Modell. Standard Groq: llama-3.3-70b-versatile. Standard Gemini: gemini-3.8-flash.
AI_MODEL=""
# AI_BASE_URL: Nur für eigene/abweichende OpenAI-kompatible Endpunkte nötig.
AI_BASE_URL=""

# GEMINI_API_KEY: Optional – nur falls du Google Gemini statt Groq nutzen willst.
# Hinweis: Der Gemini-GRATIS-Tarif hat nur 20 Anfragen/Tag. Für mehr: Groq nutzen oder bezahlter Gemini-Key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_RATE_LIMIT_PER_MIN: Max. KI-Anfragen pro Minute und IP (Kostenschutz). Standard: 10
AI_RATE_LIMIT_PER_MIN="10"

# OWNER_EMAIL: Diese E-Mail bekommt immer volle Admin-Rechte (Standard: dragosserbu6@gmail.com).
OWNER_EMAIL="dragosserbu6@gmail.com"
# ALLOW_REGISTRATION: Startwert für die Registrierung ("false" = geschlossen). Danach in der Nutzerverwaltung umschaltbar.
ALLOW_REGISTRATION="true"
# DATA_DIR: Ordner für data/users.json (Standard: ./data)
DATA_DIR=""

# APP_URL: Öffentliche Adresse der App (für Links in E-Mails, Stripe- und Login-Weiterleitungen), z. B. https://app.goalsforce.store
# ---- Bezahlung (Stripe) ----
# STRIPE_SECRET_KEY: Geheimschlüssel aus dem Stripe-Dashboard (sk_live_… oder sk_test_…)
STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET: Signatur-Schlüssel des Webhooks auf <APP_URL>/api/billing/webhook
#   Ereignisse: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Optional: feste Stripe-Preis-IDs statt der Preise aus dem Admin-Bereich
STRIPE_PRICE_MONTH=""
STRIPE_PRICE_YEAR=""
# ---- E-Mails (Resend) ----
RESEND_API_KEY=""
MAIL_FROM="Goalsforce <hallo@goalsforce.store>"
# ---- Login mit Google / Facebook ----
# Redirect-URIs: <APP_URL>/api/auth/oauth/google/callback und <APP_URL>/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# DATABASE_URL: Optional. Postgres-Verbindung (z. B. kostenlos bei Neon/Supabase).
# Wenn gesetzt, nutzt der Community-/KV-Store Postgres statt Dateien und bleibt so auch
# auf Free-Hosting erhalten. (Konten/Workspaces/Billing folgen als naechster Schritt.)
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=""
